# Copia este archivo como .env. Usa valores propios; no publiques el archivo .env.
DB_PASSWORD=
APP_BOOTSTRAP_SUPERADMIN_ENABLED=true
SUPERADMIN_CORREO=
SUPERADMIN_PASSWORD=
# Para HTTPS en producción, true. Para http://localhost:8088, false.
COOKIE_SECURE=false
WEB_PORT=8088

# Carpeta externa con configuración y certificado por RUC. No se incluye en Git.
SUNAT_SECRETS_DIR=./sunat-secrets
